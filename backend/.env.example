PORT=3000
HOST=0.0.0.0
# Set this to the externally reachable application origin for receipt QR links.
# Production requires HTTPS; local development can use a LAN origin for phone scans.
# PUBLIC_BASE_URL=https://dine-ari.example
BASE_URL=http://localhost:3000

# PostgreSQL configuration — replace each value for your environment
DB_HOST=your_postgresql_host
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_postgresql_password
# Use only a separate, dedicated database for reservation forecast integration tests.
FORECAST_TEST_DB_NAME=dinequeue_db_forecast_test
# Optional: set true when the PostgreSQL server requires SSL.
# DB_SSL=false
# Optional connection timeout in milliseconds (default: 5000).
# DB_CONNECTION_TIMEOUT_MS=5000

JWT_SECRET=replace_with_a_long_random_secret
GOOGLE_CLIENT_ID=replace_with_your_google_web_client_id
# Optional path or command for the Python executable used by the forecasting model.
# By default, Windows uses the repository's .venv-win environment when present;
# other platforms use .venv/bin/python. Relative overrides resolve from the project root.
# PYTHON_EXECUTABLE=.venv-win/Scripts/python.exe
ENABLE_FORECAST_DEVELOPMENT_DATA=false
